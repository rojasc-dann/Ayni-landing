---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ayni.ai — Innovación Colaborativa desde los Andes",
  description = "Desarrollo de software con inteligencia artificial desde La Paz, Bolivia. Aplicaciones web, móviles y consultoría IA para llevar tu negocio al siguiente nivel."
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="desarrollo software, inteligencia artificial, La Paz, Bolivia, aplicaciones web, apps móviles, consultoría IA, automatización, Ayni" />
    <meta name="author" content="Ayni.ai" />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_BO" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    
    <!-- Fonts: Space Grotesk + Manrope -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
    
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <slot />
    
    <!-- Scroll Reveal Observer -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
      );

      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
