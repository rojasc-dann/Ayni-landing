---
const services = [
  {
    id: "service-web",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>`,
    title: "Desarrollo Web",
    description: "Aplicaciones web modernas, rápidas y escalables. Desde landing pages hasta plataformas empresariales complejas con las mejores tecnologías del mercado.",
    tags: ["React", "Next.js", "Node.js", "TypeScript"],
  },
  {
    id: "service-mobile",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>`,
    title: "Desarrollo Móvil",
    description: "Apps nativas y multiplataforma que ofrecen experiencias fluidas. Diseñamos interfaces intuitivas con rendimiento de primer nivel.",
    tags: ["Flutter", "React Native", "iOS", "Android"],
  },
  {
    id: "service-ai",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a4 4 0 0 0-4 4v2H6a2 2 0 0 0-2 2v8a4 4 0 0 0 4 4h8a4 4 0 0 0 4-4v-8a2 2 0 0 0-2-2h-2V6a4 4 0 0 0-4-4z"/><circle cx="9" cy="14" r="1"/><circle cx="15" cy="14" r="1"/></svg>`,
    title: "Consultoría IA",
    description: "Integramos inteligencia artificial en tus procesos de negocio. Automatización inteligente, análisis predictivo y soluciones personalizadas con IA.",
    tags: ["Machine Learning", "LLMs", "Automatización", "Data"],
  },
];
---

<section id="servicios" class="section bg-surface-low">
  <!-- Atmospheric Orb -->
  <div class="orb orb-primary w-[600px] h-[600px] -bottom-40 -right-40 absolute"></div>

  <div class="section-content">
    <!-- Section Header -->
    <div class="reveal max-w-2xl mb-16">
      <span class="text-primary font-display text-sm font-medium tracking-widest uppercase mb-4 block">
        Nuestros Servicios
      </span>
      <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl tracking-tight mb-6">
        Soluciones que
        <span class="text-gradient">transforman</span>
      </h2>
      <p class="font-body font-light text-text-secondary text-lg leading-relaxed">
        Cada proyecto es una oportunidad de crear algo extraordinario. 
        Combinamos ingeniería de software con inteligencia artificial para 
        entregar resultados que superan expectativas.
      </p>
    </div>

    <!-- Services Grid — Asymmetric -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      {services.map((service, index) => (
        <div
          id={service.id}
          class:list={[
            "reveal group relative rounded-[var(--radius-card)] p-8 transition-all duration-500 cursor-default",
            "bg-surface-high/60 hover:bg-surface-highest/80",
            "hover:-translate-y-1",
            index === 0 ? "lg:col-span-7" : index === 1 ? "lg:col-span-5" : "lg:col-span-12",
          ]}
          style={`transition-delay: ${index * 100}ms;`}
        >
          {/* Icon */}
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-primary/10 text-primary mb-6 transition-colors duration-300 group-hover:bg-primary/15">
            <Fragment set:html={service.icon} />
          </div>

          {/* Content */}
          <h3 class="font-display font-bold text-xl sm:text-2xl tracking-tight mb-3 text-text">
            {service.title}
          </h3>
          <p class="font-body font-light text-text-secondary leading-relaxed mb-6 max-w-xl">
            {service.description}
          </p>

          {/* Tags */}
          <div class="flex flex-wrap gap-2">
            {service.tags.map((tag) => (
              <span class="px-3 py-1 rounded-full text-xs font-display font-medium text-primary/80 bg-primary/5 tracking-wide">
                {tag}
              </span>
            ))}
          </div>

          {/* Decorative corner gradient */}
          <div class="absolute top-0 right-0 w-32 h-32 rounded-tr-[var(--radius-card)] bg-gradient-to-bl from-primary/5 to-transparent pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        </div>
      ))}
    </div>
  </div>
</section>
