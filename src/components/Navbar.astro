---
const navLinks = [
  { label: "Servicios", href: "#servicios" },
  { label: "Nosotros", href: "#nosotros" },
  { label: "Equipo", href: "#equipo" },
  { label: "Contacto", href: "#contacto" },
];
---

<header id="navbar" class="fixed top-0 left-0 w-full z-50 transition-all duration-500">
  <nav class="max-w-7xl mx-auto flex items-center justify-between px-6 py-4 lg:px-8">
    <!-- Logo -->
    <a href="#" id="nav-logo" class="flex items-center gap-3 group">
      <img
        src="/logo-ayni.png"
        alt="Ayni.ai Logo"
        class="h-9 w-auto transition-transform duration-300 group-hover:scale-105"
      />
    </a>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="font-display text-sm font-medium text-text-secondary hover:text-primary transition-colors duration-300 tracking-wide"
        >
          {link.label}
        </a>
      ))}
      <a
        href="https://wa.me/59171234567?text=Hola%20Ayni%2C%20me%20interesa%20saber%20más%20sobre%20sus%20servicios"
        target="_blank"
        rel="noopener noreferrer"
        id="nav-cta"
        class="btn-luminous text-sm !py-2.5 !px-6"
      >
        Hablemos
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-toggle"
      class="md:hidden flex flex-col gap-1.5 p-2 cursor-pointer"
      aria-label="Abrir menú de navegación"
    >
      <span class="block w-6 h-0.5 bg-text transition-all duration-300 origin-center" id="bar-1"></span>
      <span class="block w-6 h-0.5 bg-text transition-all duration-300" id="bar-2"></span>
      <span class="block w-4 h-0.5 bg-text transition-all duration-300 origin-center" id="bar-3"></span>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="md:hidden overflow-hidden max-h-0 transition-all duration-500 ease-smooth"
  >
    <div class="glass px-6 py-6 flex flex-col gap-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link font-display text-lg font-medium text-text-secondary hover:text-primary transition-colors duration-300 py-2"
        >
          {link.label}
        </a>
      ))}
      <a
        href="https://wa.me/59171234567?text=Hola%20Ayni%2C%20me%20interesa%20saber%20más%20sobre%20sus%20servicios"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-luminous text-center mt-2"
      >
        Hablemos
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const bar1 = document.getElementById('bar-1');
  const bar2 = document.getElementById('bar-2');
  const bar3 = document.getElementById('bar-3');
  let isOpen = false;

  toggle?.addEventListener('click', () => {
    isOpen = !isOpen;
    if (isOpen) {
      menu!.style.maxHeight = menu!.scrollHeight + 'px';
      bar1!.style.transform = 'rotate(45deg) translate(3px, 3px)';
      bar2!.style.opacity = '0';
      bar3!.style.transform = 'rotate(-45deg) translate(3px, -3px)';
      bar3!.style.width = '1.5rem';
    } else {
      menu!.style.maxHeight = '0';
      bar1!.style.transform = 'none';
      bar2!.style.opacity = '1';
      bar3!.style.transform = 'none';
      bar3!.style.width = '1rem';
    }
  });

  // Close mobile menu on link click
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      isOpen = false;
      menu!.style.maxHeight = '0';
      bar1!.style.transform = 'none';
      bar2!.style.opacity = '1';
      bar3!.style.transform = 'none';
      bar3!.style.width = '1rem';
    });
  });

  // Navbar background on scroll
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navbar!.classList.add('glass');
    } else {
      navbar!.classList.remove('glass');
    }
  });
</script>
