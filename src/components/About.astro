---
const values = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    title: "Reciprocidad",
    description: "Ayni significa trabajo colaborativo y recíproco. Creemos que el éxito se construye juntos.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
    title: "Excelencia",
    description: "No hacemos software a medias. Cada línea de código refleja nuestro compromiso con la calidad.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="7.5 4.21 12 6.81 16.5 4.21"/><polyline points="7.5 19.79 7.5 14.6 3 12"/><polyline points="21 12 16.5 14.6 16.5 19.79"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`,
    title: "Ingeniería de Altura",
    description: "Desde La Paz llevamos tecnología de frontera al mundo. Nuestra ubicación es nuestra fuerza.",
  },
];

const stats = [
  { value: "100%", label: "Hecho en Bolivia" },
  { value: "5", label: "Ingenieros especializados" },
  { value: "IA", label: "En cada solución" },
];
---

<section id="nosotros" class="section">
  <!-- Atmospheric Orb -->
  <div class="orb orb-tertiary w-[500px] h-[500px] -top-20 -left-40 absolute"></div>

  <div class="section-content">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      <!-- Left Column — Text -->
      <div class="lg:col-span-7 reveal">
        <span class="text-tertiary font-display text-sm font-medium tracking-widest uppercase mb-4 block">
          Quiénes Somos
        </span>
        <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl tracking-tight mb-6">
          El espíritu del
          <span class="text-gradient">Ayni</span>
          en cada proyecto
        </h2>
        <p class="font-body font-light text-text-secondary text-lg leading-relaxed mb-8">
          Somos un equipo de ingenieros apasionados de La Paz, Bolivia. 
          <strong class="text-text font-normal">Ayni</strong> — del quechua, trabajo recíproco y colaborativo — 
          no es solo nuestro nombre, es nuestra filosofía. Creemos que la tecnología 
          debe servir a las personas, y que las mejores soluciones nacen de la colaboración 
          genuina entre nuestro equipo y nuestros clientes.
        </p>
        <p class="font-body font-light text-text-secondary text-lg leading-relaxed mb-10">
          Cada producto que construimos integra Inteligencia Artificial no como buzzword, 
          sino como herramienta real que potencia resultados. Desde la altura para el mundo.
        </p>

        <!-- Stats -->
        <div class="flex flex-wrap gap-8 sm:gap-12">
          {stats.map((stat) => (
            <div class="text-center sm:text-left">
              <div class="font-display font-bold text-3xl text-gradient mb-1">
                {stat.value}
              </div>
              <div class="font-body text-sm text-text-secondary">
                {stat.label}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Column — Values -->
      <div class="lg:col-span-5 flex flex-col gap-5">
        {values.map((value, index) => (
          <div
            class="reveal group relative rounded-[var(--radius-card)] p-6 bg-surface-high/40 hover:bg-surface-highest/60 transition-all duration-500 hover:-translate-y-0.5"
            style={`transition-delay: ${index * 100 + 200}ms;`}
          >
            <div class="flex gap-4">
              <div class="flex-shrink-0 inline-flex items-center justify-center w-11 h-11 rounded-xl bg-tertiary/10 text-tertiary">
                <Fragment set:html={value.icon} />
              </div>
              <div>
                <h3 class="font-display font-bold text-lg tracking-tight mb-1 text-text">
                  {value.title}
                </h3>
                <p class="font-body font-light text-text-secondary text-sm leading-relaxed">
                  {value.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
